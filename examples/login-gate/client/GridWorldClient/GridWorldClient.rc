#pragma code_page(65001)
// GridWorldClient.rc：资源脚本（登录对话框 + 世界主窗口模板）。
#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_MAIN_DIALOG DIALOGEX 0, 0, 1000, 700
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Cherry 网格世界客户端"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "已进入世界", IDC_STATUS, 10, 8, 980, 12
END

IDD_LOGIN_DIALOG DIALOGEX 0, 0, 340, 120
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "登录"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "账号:", IDC_STATIC, 10, 13, 28, 12
    EDITTEXT        IDC_ACCOUNT, 42, 11, 110, 14, ES_AUTOHSCROLL
    LTEXT           "密码:", IDC_STATIC, 10, 34, 28, 12
    EDITTEXT        IDC_PASSWORD, 42, 32, 110, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "阵营:", IDC_STATIC, 165, 13, 28, 12
    CONTROL         "红方", IDC_RADIO_RED, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 198, 11, 42, 12
    CONTROL         "黑方", IDC_RADIO_BLACK, "Button", BS_AUTORADIOBUTTON, 244, 11, 42, 12
    CONTROL         "绿方", IDC_RADIO_GREEN, "Button", BS_AUTORADIOBUTTON, 290, 11, 42, 12
    PUSHBUTTON      "连接并进入", IDC_CONNECT, 165, 30, 90, 20
    LTEXT           "未连接", IDC_STATUS, 10, 54, 320, 12
END
